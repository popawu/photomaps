# photomaps configuration
# Copy this file to .env and edit the values

# Root folder to scan for photos and videos
PHOTO_ROOT=/volume1/photo

# Comma-separated list of subfolders to exclude
EXCLUDE_SUBDIRS=misc

# Path to the GPS cache JSON file (stored next to the script by default)
CACHE_FILE=/volume1/scripts/photomaps/cache.json

# Path to the generated HTML map (served by nginx)
OUTPUT_FILE=/volume1/docker/nginx/conf/photomaps/maps.html
